#!/bin/bash
#BSUB -q hpc
#BSUB -U c27200
#BSUB -J "flye"
#BSUB -n 10
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=10-20GB]"
#BSUB -W 60000
#BSUB -o logs/4_assembly/flye.sh.o%J
#BSUB -e logs/4_assembly/flye.sh.e%J 

#Actual code
source activate meta
set -euo pipefail

SAMPLES=$(cat data/metadata/sample_names.txt)

for s in $SAMPLES; do
    flye --nano-hq results/3_filtering/${s}.filtered.fastq.gz --meta --threads 10 \
         --out-dir results/4_assembly/${s}
done