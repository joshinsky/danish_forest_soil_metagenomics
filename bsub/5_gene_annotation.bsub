#!/bin/bash
#BSUB -q hpc
#BSUB -U c27200
#BSUB -J bakta
#BSUB -n 10
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=5GB]"
#BSUB -W 600
#BSUB -o logs/5_gene_annotation/bakta.sh.o%J
#BSUB -e logs/5_gene_annotation/bakta.sh.e%J 

#Actual code
source activate bakta
set -euo pipefail

SAMPLES=$(cat data/metadata/sample_names.txt)

for s in $SAMPLES; do
    bakta results/4_assembly/${s}/assembly.fasta \
    --db /dtu/datasets3/c27200/databases/bakta/db-light/ \
    --output results/5_gene_annotation/${s} --prefix ${s} --force \
    --meta \
    --threads 10 \
    --skip-trna \
    --skip-tmrna \
    --skip-rrna \
    --skip-ncrna \
    --skip-ncrna-region \
    --skip-crispr \
    --skip-sorf \
    --skip-ori \
    --skip-plot
done